  "start": 17.7,
  "text": "For one hour.",
  "dur": 1.632
 },
 "n3": {
  "role": "narrator",
  "start": 19.4,
  "text": "When time started again... every child came home.",
  "dur": 4.44
 },
 "n4": {
  "role": "narrator",
  "start": 24.05,
  "text": "Except one.",
  "dur": 1.704
 },
 "s1": {
